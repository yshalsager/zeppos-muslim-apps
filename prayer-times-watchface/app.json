{
  "configVersion": "v3",
  "app": {
    "appId": 1136165,
    "appName": "Prayer Times",
    "appType": "watchface",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "custom",
    "description": "Prayer times watchface for Amazfit Bip Max"
  },
  "permissions": [
    "data:user.hd.step",
    "data:user.hd.heart_rate",
    "data:user.hd.calorie",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0.0",
      "target": "3.0.0",
      "minVersion": "3.0.0"
    }
  },
  "targets": {
    "bip-max": {
      "module": {
        "watchface": {
          "path": "watchface/index",
          "main": 1,
          "editable": 1,
          "lockscreen": 1
        }
      },
      "platforms": [
        {
          "name": "bip-max",
          "deviceSource": 11206915
        }
      ],
      "designWidth": 432
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Prayer Times"
    },
    "ar-SA": {
      "appName": "مواقيت الصلاة"
    },
    "ar-EG": {
      "appName": "مواقيت الصلاة"
    }
  },
  "defaultLanguage": "en-US"
}
